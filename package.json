{
  "name": "het-spectrum-sollicitaties-app",
  "version": "1.0.0",
  "description": "Interne sollicitatie-app voor Het Spectrum",
  "type": "module",
  "scripts": {
    "dev": "./run-with-node20.sh node server/server.js",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server",
    "vercel-build": "npm run build",
    "preview": "NODE_ENV=production ./run-with-node20.sh node server/server.js",
    "migrate": "./run-with-node20.sh node server/db/migrations/run.js",
